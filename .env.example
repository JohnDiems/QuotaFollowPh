# Copy to .env. Keep all secrets server-side. Use NUXT_ names for runtime overrides.
NUXT_APP_URL=http://localhost:3000
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
NUXT_SUPABASE_SERVICE_KEY=
# Set an API model available in your OpenAI project. No AI requests without both values.
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_MODEL=
# Test keys first. Current checkout grants one month; renewal is manual.
NUXT_PAYMONGO_SECRET_KEY=
NUXT_PAYMONGO_WEBHOOK_SECRET=
NUXT_BILLING_AMOUNT=49900
NUXT_BILLING_REQUIRED=false
# Optional email delivery and scheduled owner reminders
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=
NUXT_CRON_SECRET=

# Email provider: resend (default) or gmail. Gmail uses the account address as From.
NUXT_MAIL_PROVIDER=resend
NUXT_GMAIL_USER=
# Google App Password, not the normal Gmail account password.
NUXT_GMAIL_APP_PASSWORD=
